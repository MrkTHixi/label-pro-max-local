{
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.3.0",
    "better-sqlite3": "^12.11.1",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "xlsx": "^0.18.5"
  },
  "description": "Local-first label printing system for Thai parcel labels (100x150mm). No cloud, no sync โ€” each branch PC runs everything locally.",
  "engines": {
    "node": ">=22"
  },
  "name": "label-pro-max-local",
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "scripts": {
    "backup": "node scripts/backup.mjs",
    "import-excel": "node scripts/import-excel.mjs",
    "restore": "node scripts/restore.mjs",
    "smoke": "node tests/smoke.mjs",
    "test:windows": "node tests/windows-launch.mjs",
    "start": "node scripts/runtime.mjs",
    "server": "node server/index.mjs",
    "setup": "node node_modules/playwright/cli.js install chromium --only-shell",
    "update": "node scripts/update.mjs",
    "worker": "node server/print-worker.mjs"
  },
  "type": "module",
  "version": "0.3.0",
  "optionalDependencies": {
    "pdf-to-printer": "^5.8.1"
  }
